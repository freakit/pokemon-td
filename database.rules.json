{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id','hostId','createdAt']) || !newData.exists()"
      }
    },
    "gameStates": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "towerDetails": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.uid === $userId || $userId.matches(/^ai_/))"
        }
      }
    },
    "battleResults": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "debuffs": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$userId": {
          ".read": "auth != null && auth.uid === $userId",
          ".write": "auth != null"
        }
      }
    },
    "presence": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.uid === $userId || $userId.matches(/^ai_/))"
        }
      }
    }
  }
}
